#!/usr/bin/env python3
"""
ai-skills: Manage and sync AI Agent Skills across Codex and Antigravity
from ~/.config/ai-skills/sources.json without shared ~/.agents directories.
"""

from __future__ import annotations

import argparse
import datetime as dt
import hashlib
import json
import shutil
import subprocess
import sys
import tempfile
import urllib.request
from pathlib import Path

CONFIG_PATH = Path.home() / ".config" / "ai-skills" / "sources.json"
STATE_PATH = Path.home() / ".config" / "ai-skills" / "state.json"


def load_config() -> dict:
    if not CONFIG_PATH.exists():
        sys.exit(f"Error: config not found at {CONFIG_PATH}")
    return json.loads(CONFIG_PATH.read_text(encoding="utf-8"))


def load_state() -> dict:
    if not STATE_PATH.exists():
        return {"sources": {}, "installedByTarget": {}}
    data = json.loads(STATE_PATH.read_text(encoding="utf-8"))
    data.setdefault("sources", {})
    data.setdefault("installedByTarget", {})
    return data


def save_state(state: dict) -> None:
    STATE_PATH.parent.mkdir(parents=True, exist_ok=True)
    STATE_PATH.write_text(
        json.dumps(state, indent=2, ensure_ascii=False) + "\n",
        encoding="utf-8",
    )


def extract_source_skills(src: dict) -> list[str]:
    """Infer skill directory names declared or previously tracked by a source."""
    if src.get("managedSkills"):
        return list(src["managedSkills"])
    if "subpaths" in src:
        return [Path(p).name for p in src["subpaths"]]
    if "skillName" in src:
        return [src["skillName"]]
    return []


def import_legacy_config(legacy_path: Path) -> int:
    """Migrate inline revision/install metadata from a legacy sources.json into state.json."""
    if not legacy_path.exists():
        sys.exit(f"Error: legacy config not found at {legacy_path}")
    legacy_cfg = json.loads(legacy_path.read_text(encoding="utf-8"))
    state = load_state()
    sources_state = state["sources"]
    installed_by_target = {
        k: set(v) for k, v in state["installedByTarget"].items()
    }

    for src in legacy_cfg.get("sources", []):
        sid = src["id"]
        skills = sorted(extract_source_skills(src))
        if any(k in src for k in ("lastRevision", "lastSyncedAt", "managedSkills")):
            entry = dict(sources_state.get(sid, {}))
            if "lastRevision" in src and "lastRevision" not in entry:
                entry["lastRevision"] = src["lastRevision"]
            if "lastSyncedAt" in src and "lastSyncedAt" not in entry:
                entry["lastSyncedAt"] = src["lastSyncedAt"]
            if skills and "managedSkills" not in entry:
                entry["managedSkills"] = skills
            if entry:
                sources_state[sid] = entry
        for tname in src.get("targets", []):
            installed_by_target.setdefault(tname, set()).update(skills)

    state["installedByTarget"] = {
        k: sorted(v) for k, v in sorted(installed_by_target.items())
    }
    save_state(state)
    print(f"已从 {legacy_path} 导入 {len(sources_state)} 个来源状态到 {STATE_PATH}")
    return 0


def dir_digest(path: Path) -> str:
    if not path.exists():
        return ""
    h = hashlib.sha256()
    for p in sorted(f for f in path.rglob("*") if f.is_file()):
        rel = p.relative_to(path).as_posix()
        h.update(rel.encode("utf-8") + b"\0")
        h.update(p.read_bytes() + b"\0")
    return h.hexdigest()


def clone_shallow(
    repo: str,
    branch: str,
    dest: Path,
    sparse_dirs: list[str] | None = None,
    sparse_files: list[str] | None = None,
) -> str:
    base_flags = ["git", "clone", "--depth", "1", "--filter=blob:none"]
    if sparse_dirs or sparse_files:
        base_flags.append("--no-checkout")

    cmd = list(base_flags)
    if branch:
        cmd += ["--branch", branch]
    cmd += [repo, str(dest)]
    res = subprocess.run(cmd, capture_output=True, text=True)
    if res.returncode != 0:
        if dest.exists():
            shutil.rmtree(dest)
        res2 = subprocess.run(
            [*base_flags, repo, str(dest)],
            capture_output=True,
            text=True,
        )
        if res2.returncode != 0:
            raise RuntimeError(res2.stderr.strip() or res.stderr.strip())

    if sparse_dirs:
        subprocess.run(
            ["git", "-C", str(dest), "sparse-checkout", "init", "--cone"],
            check=True,
            capture_output=True,
            text=True,
        )
        subprocess.run(
            ["git", "-C", str(dest), "sparse-checkout", "set", *sparse_dirs],
            check=True,
            capture_output=True,
            text=True,
        )
        subprocess.run(
            ["git", "-C", str(dest), "checkout"],
            check=True,
            capture_output=True,
            text=True,
        )
    elif sparse_files:
        subprocess.run(
            ["git", "-C", str(dest), "checkout", "HEAD", "--", *sparse_files],
            check=True,
            capture_output=True,
            text=True,
        )

    rev = subprocess.run(
        ["git", "-C", str(dest), "rev-parse", "--short=10", "HEAD"],
        capture_output=True,
        text=True,
        check=True,
    )
    return rev.stdout.strip()


def fetch_http_files(base_url: str, files: list[str], dest: Path) -> str:
    base = base_url.rstrip("/")
    for rel in files:
        url = f"{base}/{rel.lstrip('/')}"
        req = urllib.request.Request(url, headers={"User-Agent": "ai-skills-updater/1.0"})
        with urllib.request.urlopen(req, timeout=20) as resp:
            data = resp.read()
        out = dest / rel
        out.parent.mkdir(parents=True, exist_ok=True)
        out.write_bytes(data)
    return dir_digest(dest)[:10]


def stage_source(src: dict, tmp_root: Path) -> tuple[dict[str, dict[str, Path]], str]:
    """Return ({target_name: {skill_name: staged_skill_dir}}, revision_id)."""
    stype = src["type"]
    targets = src["targets"]
    work = tmp_root / src["id"]
    staged_root = tmp_root / f"{src['id']}_staged"
    staged_root.mkdir(parents=True, exist_ok=True)

    if stype in ("git-bundle", "git-dir", "git-dirs", "git-files"):
        if stype == "git-bundle":
            rev = clone_shallow(
                src["repo"], src.get("branch", ""), work, sparse_dirs=[src["subpath"]]
            )
            bundle_dir = work / src["subpath"]
            skills: dict[str, Path] = {}
            for child in sorted(bundle_dir.iterdir()):
                if child.is_dir() and (child / "SKILL.md").exists():
                    skills[child.name] = child
            return {t: skills for t in targets}, rev
        if stype == "git-dir":
            if "targetSubpaths" in src:
                tmap = src["targetSubpaths"]
                missing = [t for t in targets if t not in tmap]
                if missing:
                    raise RuntimeError(
                        f"targetSubpaths missing targets for {src['id']}: {', '.join(missing)}"
                    )
                sparse_dirs = list(dict.fromkeys(tmap[t] for t in targets))
                rev = clone_shallow(
                    src["repo"], src.get("branch", ""), work, sparse_dirs=sparse_dirs
                )
                by_target: dict[str, dict[str, Path]] = {}
                for t in targets:
                    sdir = work / tmap[t]
                    if not (sdir / "SKILL.md").exists():
                        raise RuntimeError(f"SKILL.md not found in {tmap[t]}")
                    by_target[t] = {src["skillName"]: sdir}
                return by_target, rev
            rev = clone_shallow(
                src["repo"], src.get("branch", ""), work, sparse_dirs=[src["subpath"]]
            )
            sdir = work / src["subpath"]
            if not (sdir / "SKILL.md").exists():
                raise RuntimeError(f"SKILL.md not found in {src['subpath']}")
            return {t: {src["skillName"]: sdir} for t in targets}, rev
        if stype == "git-dirs":
            rev = clone_shallow(
                src["repo"], src.get("branch", ""), work, sparse_dirs=src["subpaths"]
            )
            skills = {}
            for rel in src["subpaths"]:
                sdir = work / rel
                if not (sdir / "SKILL.md").exists():
                    raise RuntimeError(f"SKILL.md not found in {rel}")
                skills[sdir.name] = sdir
            return {t: skills for t in targets}, rev
        if stype == "git-files":
            rev = clone_shallow(
                src["repo"], src.get("branch", ""), work, sparse_files=src["files"]
            )
            out = staged_root / src["skillName"]
            out.mkdir(parents=True, exist_ok=True)
            for rel in src["files"]:
                src_file = work / rel
                dst_file = out / rel
                dst_file.parent.mkdir(parents=True, exist_ok=True)
                shutil.copy2(src_file, dst_file)
            return {t: {src["skillName"]: out} for t in targets}, rev

    if stype == "http-files":
        out = staged_root / src["skillName"]
        out.mkdir(parents=True, exist_ok=True)
        rev = fetch_http_files(src["baseUrl"], src["files"], out)
        return {t: {src["skillName"]: out} for t in targets}, rev

    raise ValueError(f"Unsupported source type: {stype}")


def cmd_list(cfg: dict, state: dict) -> int:
    print(f"配置文件: {CONFIG_PATH}")
    print(f"状态文件: {STATE_PATH}\n")
    print("目标目录:")
    for tname, tpath in cfg["targets"].items():
        resolved = Path(tpath).expanduser()
        count = sum(
            1
            for p in resolved.iterdir()
            if p.is_dir() and not p.name.startswith(".") and (p / "SKILL.md").exists()
        ) if resolved.exists() else 0
        print(f"  - {tname:12s}: {resolved} ({count} skills)")
    print("\n已配置来源:")
    sources_state = state.get("sources", {})
    for src in cfg["sources"]:
        sstate = sources_state.get(src["id"], {})
        upstream = src.get("repo") or src.get("baseUrl")
        rev = sstate.get("lastRevision") or src.get("lastRevision", "未记录")
        updated = sstate.get("lastSyncedAt") or src.get("lastSyncedAt", "未记录")
        targets = ", ".join(src["targets"])
        managed = sstate.get("managedSkills") or src.get("managedSkills")
        if "subpaths" in src:
            count_info = ", ".join(Path(p).name for p in src["subpaths"])
        elif src["type"] == "git-bundle" and managed:
            count_info = f"{len(managed)} 个技能"
        else:
            count_info = src.get("skillName", src["id"])
        print(f"  [{src['id']}] ({count_info} -> {targets})")
        print(f"    上游: {upstream}")
        print(f"    状态: rev={rev} | 上次同步={updated}")
    return 0


def sync_all(cfg: dict, state: dict, apply_changes: bool, only_id: str | None = None) -> int:
    sources = cfg["sources"]
    if only_id is not None:
        sources = [s for s in sources if s["id"] == only_id]
        if not sources:
            sys.exit(f"Error: source '{only_id}' not found in {CONFIG_PATH}")

    targets = {k: Path(v).expanduser() for k, v in cfg["targets"].items()}
    if apply_changes:
        for tpath in targets.values():
            tpath.mkdir(parents=True, exist_ok=True)

    sources_state = state.setdefault("sources", {})
    installed_by_target = {
        k: set(v) for k, v in state.setdefault("installedByTarget", {}).items()
    }
    active_by_target: dict[str, set[str]] = {t: set() for t in targets}

    any_updates = False
    now_iso = dt.datetime.now().astimezone().isoformat(timespec="seconds")

    with tempfile.TemporaryDirectory(prefix="ai-skills-") as tmp:
        tmp_root = Path(tmp)
        for src in sources:
            sid = src["id"]
            upstream = src.get("repo") or src.get("baseUrl")
            print(f"→ 检查 [{sid}] ({upstream}) ...")
            by_target, rev = stage_source(src, tmp_root)

            changed_targets: list[str] = []
            prev_managed = set(
                sources_state.get(sid, {}).get("managedSkills")
                or src.get("managedSkills", [])
            )
            curr_managed = set().union(*(m.keys() for m in by_target.values()))
            retired = (
                prev_managed - curr_managed
                if src["type"] in ("git-bundle", "git-dirs")
                else set()
            )
            first_installed_dir: Path | None = None

            for tname in src["targets"]:
                troot = targets[tname]
                skills_map = by_target[tname]
                active_by_target.setdefault(tname, set()).update(skills_map.keys())
                for sname, staged_dir in skills_map.items():
                    installed_dir = troot / sname
                    if dir_digest(installed_dir) != dir_digest(staged_dir):
                        state_label = "新增" if not installed_dir.exists() else "更新"
                        changed_targets.append(f"{tname}:{sname}({state_label})")
                        if apply_changes:
                            if installed_dir.exists():
                                shutil.rmtree(installed_dir)
                            shutil.copytree(staged_dir, installed_dir)
                            if first_installed_dir is None:
                                first_installed_dir = installed_dir

                for old_name in sorted(retired):
                    old_dir = troot / old_name
                    if old_dir.exists():
                        changed_targets.append(f"{tname}:{old_name}(移除已废弃)")
                        if apply_changes:
                            shutil.rmtree(old_dir)

            if changed_targets:
                any_updates = True
                action = "已同步" if apply_changes else "待更新"
                print(f"  ↑ {action} (rev {rev}): {', '.join(changed_targets)}")
                if apply_changes and "postSync" in src and first_installed_dir is not None:
                    post_cfg = src["postSync"]
                    post_cmd = [str(first_installed_dir / post_cfg[0]), *post_cfg[1:]]
                    res = subprocess.run(post_cmd, check=False, capture_output=True, text=True)
                    if res.returncode == 0 and res.stdout.strip():
                        print(f"  ⚙ postSync: {res.stdout.strip().splitlines()[0]}")
                    elif res.returncode != 0:
                        msg = res.stderr.strip() or f"exit code {res.returncode}"
                        print(f"  ! postSync 警告: {msg}")
            else:
                print(f"  ✓ 已是最新 (rev {rev}, 共 {len(curr_managed)} 项)")

            if apply_changes:
                sources_state[sid] = {
                    "lastRevision": rev,
                    "lastSyncedAt": now_iso,
                    "managedSkills": sorted(curr_managed),
                }
                for tname in src["targets"]:
                    tset = installed_by_target.setdefault(tname, set())
                    tset.update(by_target[tname].keys())
                    tset.difference_update(retired)

    if only_id is None:
        retired_global = set(cfg.get("retiredSkills", []))
        removed_items: list[str] = []
        for tname, troot in targets.items():
            active = active_by_target.get(tname, set())
            orphans = (installed_by_target.get(tname, set()) - active) | (
                retired_global - active
            )
            for old_name in sorted(orphans):
                old_dir = troot / old_name
                if old_dir.exists():
                    removed_items.append(f"{tname}:{old_name}")
                    any_updates = True
                    if apply_changes:
                        shutil.rmtree(old_dir)
            if apply_changes:
                installed_by_target[tname] = set(active)

        if removed_items:
            label = "已清理已移除技能" if apply_changes else "待清理已移除技能"
            prefix = "✂" if apply_changes else "↑"
            print(f"{prefix} {label}: {', '.join(removed_items)}")

        if apply_changes:
            valid_ids = {s["id"] for s in cfg["sources"]}
            for dead_id in list(sources_state.keys()):
                if dead_id not in valid_ids:
                    del sources_state[dead_id]

    if apply_changes:
        state["installedByTarget"] = {
            k: sorted(v) for k, v in sorted(installed_by_target.items())
        }
        save_state(state)
        print(f"\n全部同步完成，本机状态已写入 {STATE_PATH}")
    else:
        if any_updates:
            print("\n检测到以上技能有更新，执行 `ai-skills update` 即可一键更新。")
        else:
            print("\n所有客户端技能均已是最新版本。")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="ai-skills",
        description="检查并同步 Codex 与 Antigravity 的全局 AI Skills",
    )
    sub = parser.add_subparsers(dest="cmd")
    sub.add_parser("list", help="查看已配置的技能来源与状态")
    p_check = sub.add_parser("check", help="仅检查上游是否有更新（不修改本地文件）")
    p_check.add_argument("source_id", nargs="?", help="可选：仅检查指定的技能源 id")
    p_update = sub.add_parser("update", help="拉取所有上游最新技能并同步到 Codex 和 Antigravity")
    p_update.add_argument("source_id", nargs="?", help="可选：仅更新指定的技能源 id")
    p_import = sub.add_parser("import-legacy", help="从旧版 sources.json 导入同步状态到 state.json")
    p_import.add_argument("legacy_config_path", help="旧版 sources.json 文件路径")

    args = parser.parse_args()
    if args.cmd == "import-legacy":
        return import_legacy_config(Path(args.legacy_config_path).expanduser())

    cfg = load_config()
    state = load_state()
    cmd = args.cmd or "list"
    if cmd == "list":
        return cmd_list(cfg, state)
    if cmd == "check":
        return sync_all(cfg, state, apply_changes=False, only_id=args.source_id)
    if cmd == "update":
        return sync_all(cfg, state, apply_changes=True, only_id=args.source_id)
    return 0


if __name__ == "__main__":
    sys.exit(main())
